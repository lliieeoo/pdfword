{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "pages/api/convert/word-to-pdf.js": {
      "memory": 256,
      "maxDuration": 60,
      "bodySizeLimit": "50mb"
    },
    "pages/api/convert/pdf-to-word.js": {
      "memory": 256,
      "maxDuration": 60,
      "bodySizeLimit": "50mb"
    }
  },
  "routes": [
    {
      "src": "/fonts/(.*)",
      "dest": "/fonts/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=512"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_MAX_FILE_SIZE": "52428800"
    }
  }
}